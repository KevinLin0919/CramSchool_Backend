# 複製成 .env 後填寫。.env 不進版控。

POSTGRES_DB=cramschool
POSTGRES_USER=cram
POSTGRES_PASSWORD=            # 必填：openssl rand -base64 32

# 對外位址由主機上的 Tailscale 提供（見 README「上線」），
# 這裡不需要網域、憑證或 port forwarding 的設定。

# ── 學校的 Microsoft 帳號登入（選配）─────────────────────────
# 兩個都填了才算設定完成；缺一個就整條回報未設定，而不是半動半不動。
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=

# 租戶裡的任何人都能登入，還是只有已經是老師的帳號才行。
# 預設 false。目錄裡不只有老師，而這個服務存的是全補習班的標準答案。
# MICROSOFT_AUTO_PROVISION=false

# 用 Microsoft 換到的裝置 token 幾天後過期。
# 沒有到期時間的話，在 Entra 停用某人並不會讓他 iPad 上那組 token 失效。
# MICROSOFT_TOKEN_DAYS=30

# 網頁班級報告也提供 Microsoft 登入。要先在同一個 app registration 加上
# 「單頁應用程式（SPA）」平台與回呼網址 https://<這台的網址>/web/，否則
# 按鈕只會把人帶到 Microsoft 的錯誤頁。
# MICROSOFT_WEB_LOGIN=false
